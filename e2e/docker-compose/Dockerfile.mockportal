FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /mockportal ./e2e/mockportal

FROM alpine:3.19
RUN apk add --no-cache ca-certificates wget
COPY --from=builder /mockportal /mockportal
EXPOSE 8080
ENTRYPOINT ["/mockportal"]
