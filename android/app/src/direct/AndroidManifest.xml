<?xml version="1.0" encoding="utf-8"?>
<!-- The direct build (get.wantastic.app) installs its own updates. Never in
     the Play build: Google Play allows updates only through Play. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates install without a prompt once Wantastic installed itself. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
