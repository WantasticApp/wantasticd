FROM golang:1.24-alpine AS builder

RUN apk add --no-cache curl && curl -sSfL https://raw.githubusercontent.com/air-verse/air/master/install.sh | sh -s -- -b /go/bin

FROM openwrt/rootfs:x86-64-23.05.0

# Copy Go and Air from alpine
COPY --from=builder /usr/local/go /usr/local/go
COPY --from=builder /go/bin/air /usr/local/bin/air
ENV PATH="/usr/local/go/bin:${PATH}"
# add 8.8.8.8 in /etc/resolv.conf to ensure network access for opkg
# OpenWrt requires /var/lock for opkg to work correctly in some containerized environments
RUN mkdir -p /var/lock
RUN opkg update && \
    opkg install iperf3 iputils-ping dropbear curl ca-bundle tar || \
    echo "WARNING: opkg install failed (network/feed issue) — continuing without optional packages"

WORKDIR /app
COPY e2e/docker-compose/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
