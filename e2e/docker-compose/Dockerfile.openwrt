FROM golang:1.24-bookworm AS builder

# Install libiwinfo headers for CGo compilation
RUN apt-get update && apt-get install -y git gcc libc6-dev \
    && git clone --depth=1 https://git.openwrt.org/project/iwinfo.git /tmp/iwinfo \
    && mkdir -p /usr/local/include \
    && cp /tmp/iwinfo/include/iwinfo.h /usr/local/include/ \
    # Create stub libiwinfo.a for linking (real .so is on the device at runtime)
    && echo 'void iwinfo_finish(void){} const void* iwinfo_backend(const char* n){return 0;}' > /tmp/iwinfo_stub.c \
    && gcc -c /tmp/iwinfo_stub.c -o /tmp/iwinfo_stub.o \
    && ar rcs /usr/local/lib/libiwinfo.a /tmp/iwinfo_stub.o \
    && rm -rf /tmp/iwinfo /tmp/iwinfo_stub.*

WORKDIR /app
COPY . .
RUN CGO_ENABLED=1 CGO_CFLAGS="-I/usr/local/include" CGO_LDFLAGS="-L/usr/local/lib" \
    go build -tags iwinfo -o wantasticd ./cmd/wantasticd

FROM openwrt/rootfs:x86-64-23.05.0
# OpenWrt requires /var/lock for opkg to work correctly in some containerized environments
RUN mkdir -p /var/lock && opkg update && opkg install iperf3 iputils-ping dropbear libiwinfo

COPY --from=builder /app/wantasticd /wantasticd/wantasticd
COPY e2e/docker-compose/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
